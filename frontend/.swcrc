{
    "$schema": "https://swc.rs/schema.json",
    "jsc": {
        "minify": {
            "compress": true
        },
        "parser": {
            "syntax": "typescript",
            "tsx": false,
            "decorators": false,
            "dynamicImport": false
        },
        "target": "es2015",
        "loose": false,
        "externalHelpers": false,
        "keepClassNames": false
    },
    "module": {
        "type": "es6"
    },
    "minify": true
}